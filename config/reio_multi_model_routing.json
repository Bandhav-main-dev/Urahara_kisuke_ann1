{
  "schema_version": "1.0",
  "architecture": "reio_dual_openrouter_dual_ollama",
  "description": "REIŌ model architecture using two OpenRouter routes and two local Ollama assistant models.",
  "authoritative_layer": {
    "name": "REIŌ Evidence and Provenance Engine",
    "authority": "source_evidence",
    "llm_facts_are_not_authoritative": true,
    "require_source_segment_for_claim": true
  },
  "routes": {
    "openrouter_primary": {
      "provider": "openrouter",
      "role": "deep_reasoning",
      "model": "anthropic/claude-sonnet-4.5",
      "enabled": true,
      "priority": 1,
      "environment_key": "OPENROUTER_API_KEY",
      "tasks": [
        "cognitive_pattern_analysis",
        "evidence_interpretation",
        "reasoning_analysis",
        "complex_research_tasks"
      ]
    },
    "openrouter_secondary": {
      "provider": "openrouter",
      "role": "independent_structured_reasoning",
      "model": "openai/gpt-5.4",
      "enabled": true,
      "priority": 2,
      "environment_key": "OPENROUTER_API_KEY",
      "tasks": [
        "structured_analysis",
        "independent_verification",
        "schema_generation",
        "candidate_generation"
      ]
    },
    "ollama_assistant_1": {
      "provider": "ollama",
      "role": "local_assistant",
      "model": "qwen3:latest",
      "enabled": true,
      "priority": 3,
      "base_url": "http://127.0.0.1:11434",
      "tasks": [
        "local_preprocessing",
        "classification",
        "formatting",
        "lightweight_reasoning"
      ]
    },
    "ollama_assistant_2": {
      "provider": "ollama",
      "role": "local_validator",
      "model": "llama3.1:8b",
      "enabled": true,
      "priority": 4,
      "base_url": "http://127.0.0.1:11434",
      "tasks": [
        "local_validation",
        "consistency_check",
        "schema_validation",
        "candidate_review"
      ]
    }
  },
  "execution_policy": {
    "cloud_routes": [
      "openrouter_primary",
      "openrouter_secondary"
    ],
    "local_routes": [
      "ollama_assistant_1",
      "ollama_assistant_2"
    ],
    "preferred_flow": [
      "task_classification",
      "select_model_route",
      "generate_candidate",
      "independent_validation",
      "provenance_validation",
      "accept_or_review"
    ],
    "critical_evidence_policy": {
      "source_text_required": true,
      "source_id_required": true,
      "segment_id_required": true,
      "unsupported_fact_rejected": true
    }
  },
  "fallback_policy": {
    "openrouter_failure": "use_ollama_assistant",
    "ollama_unavailable": "use_openrouter",
    "all_models_unavailable": "return_controlled_failure",
    "never_invent_evidence": true
  },
  "omniroute": {
    "enabled": false,
    "removed_from_active_architecture": true
  }
}